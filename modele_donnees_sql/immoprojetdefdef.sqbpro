<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="immoprojetdefdef.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="browser pragmas query" current="2"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1954"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Departement" custom_title="0" dock_id="1" table="4,11:mainDepartement"/><dock_state state="000000ff00000000fd00000001000000020000032800000226fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000003280000012400ffffff0000025b0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Bien" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="50"/><column index="2" value="155"/><column index="3" value="52"/><column index="4" value="39"/><column index="5" value="63"/><column index="6" value="210"/><column index="7" value="70"/><column index="8" value="90"/><column index="9" value="82"/><column index="10" value="93"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Commune" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="1" mode="0"/></sort><column_widths><column index="1" value="153"/><column index="2" value="116"/><column index="3" value="96"/><column index="4" value="75"/><column index="5" value="234"/><column index="6" value="68"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Departement" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="113"/><column index="2" value="300"/><column index="3" value="78"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Region" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="77"/><column index="2" value="210"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="nb_appartements_vendus*">SELECT COUNT(*) AS nb_appartements_vendus
FROM Vente v
JOIN Bien b ON v.id_bien = b.id_bien
WHERE b.type_local = 'Appartement'
  AND v.date BETWEEN '2020-01-01' AND '2020-06-30';
</sql><sql name="nb_appartements_vendus_par_région*">SELECT 
    r.nom_region,
    COUNT(*) AS nb_ventes_appartements
FROM Vente v
JOIN Bien b ON v.id_bien = b.id_bien
JOIN Commune c ON b.id_coddep_codecommune = c.id_coddep_codecommune
JOIN Departement d ON c.code_departement = d.code_departement
JOIN Region r ON d.code_region = r.code_region
WHERE b.type_local = 'Appartement'
  AND v.date BETWEEN '2020-01-01' AND '2020-06-30'
GROUP BY r.nom_region
ORDER BY nb_ventes_appartements DESC;
</sql><sql name="Proportion des ventes d’appartements par le nombre de pièces*">-- Total des ventes d'appartements par nombre de pièces
WITH ventes_par_pieces AS (
    SELECT 
        b.total_piece,
        COUNT(*) AS nb_ventes
    FROM Vente v
    JOIN Bien b ON v.id_bien = b.id_bien
    WHERE b.type_local = 'Appartement'
    GROUP BY b.total_piece
),

-- Total global des ventes d'appartements
total_ventes AS (
    SELECT COUNT(*) AS total
    FROM Vente v
    JOIN Bien b ON v.id_bien = b.id_bien
    WHERE b.type_local = 'Appartement'
)

-- Calcul des proportions
SELECT 
    vpp.total_piece,
    vpp.nb_ventes,
    ROUND(100.0 * vpp.nb_ventes / tv.total, 2) AS proportion_pourcentage
FROM ventes_par_pieces vpp, total_ventes tv
ORDER BY vpp.total_piece;
</sql><sql name="Les 10 départements où le prix au m² est le plus élevé*">SELECT 
    d.nom_departement,
    d.code_departement,
    ROUND(AVG(v.valeur / b.surface_local), 2) AS prix_m2_moyen
FROM Vente v
JOIN Bien b ON v.id_bien = b.id_bien
JOIN Commune c ON b.id_coddep_codecommune = c.id_coddep_codecommune
JOIN Departement d ON c.code_departement = d.code_departement
WHERE b.surface_local &gt; 0 
  AND v.valeur IS NOT NULL
GROUP BY d.code_departement
ORDER BY prix_m2_moyen DESC
LIMIT 10;
</sql><sql name="Taux d’évolution du nombre de ventes entre le 1er trimestre (T1) et le 2e trimestre (T2) de 2020*">WITH ventes_par_trimestre AS (
    SELECT 
        'T1_2020' AS trimestre,
        COUNT(*) AS nb_ventes
    FROM Vente
    WHERE date BETWEEN '2020-01-01' AND '2020-03-31'
    
    UNION ALL
    
    SELECT 
        'T2_2020' AS trimestre,
        COUNT(*) AS nb_ventes
    FROM Vente
    WHERE date BETWEEN '2020-04-01' AND '2020-06-30'
),

-- Extraction des ventes T1 et T2 dans des colonnes séparées
taux_evolution AS (
    SELECT 
        (SELECT nb_ventes FROM ventes_par_trimestre WHERE trimestre = 'T1_2020') AS ventes_T1,
        (SELECT nb_ventes FROM ventes_par_trimestre WHERE trimestre = 'T2_2020') AS ventes_T2
)

-- Calcul du taux d'évolution
SELECT 
    ventes_T1,
    ventes_T2,
    ROUND(100.0 * (ventes_T2 - ventes_T1) / ventes_T1, 2) AS taux_evolution_pourcentage
FROM taux_evolution;
</sql><sql name="Classement des régions par prix au m² des appartements de +4 pièces*">SELECT 
    r.nom_region,
    ROUND(AVG(v.valeur / b.surface_local), 2) AS prix_m2_moyen
FROM Vente v
JOIN Bien b ON v.id_bien = b.id_bien
JOIN Commune c ON b.id_coddep_codecommune = c.id_coddep_codecommune
JOIN Departement d ON c.code_departement = d.code_departement
JOIN Region r ON d.code_region = r.code_region
WHERE b.type_local = 'Appartement'
  AND b.total_piece &gt; 4
  AND b.surface_local &gt; 0
  AND v.valeur IS NOT NULL
GROUP BY r.nom_region
ORDER BY prix_m2_moyen DESC;
</sql><sql name="Liste des communes ayant eu ≥ 50 ventes au 1er trimestre*">SELECT 
    c.nom_commune,
    c.code_postal,
    COUNT(*) AS nb_ventes
FROM Vente v
JOIN Bien b ON v.id_bien = b.id_bien
JOIN Commune c ON b.id_coddep_codecommune = c.id_coddep_codecommune
WHERE v.date BETWEEN '2020-01-01' AND '2020-03-31'
GROUP BY c.id_coddep_codecommune
HAVING nb_ventes &gt;= 50
ORDER BY nb_ventes DESC;
</sql><sql name="Différence en % du prix/m² entre un appart. 2 pièces et un appart. 3 pièces*">WITH prix_par_piece AS (
    SELECT 
        b.total_piece,
        ROUND(AVG(v.valeur / b.surface_carrez), 2) AS prix_m2
    FROM Vente v
    JOIN Bien b ON v.id_bien = b.id_bien
    WHERE b.type_local = 'Appartement'
      AND b.surface_carrez &gt; 0
      AND v.valeur IS NOT NULL
      AND b.total_piece IN (2, 3)
    GROUP BY b.total_piece
),

diff AS (
    SELECT
        MAX(CASE WHEN total_piece = 2 THEN prix_m2 END) AS prix_2p,
        MAX(CASE WHEN total_piece = 3 THEN prix_m2 END) AS prix_3p
    FROM prix_par_piece
)

SELECT 
    prix_2p,
    prix_3p,
    ROUND(100.0 * (prix_3p - prix_2p) / prix_2p, 2) AS difference_pourcentage
FROM diff;
</sql><sql name="Valeurs moyennes pour le top 3 des communes dans départements 6, 13, 33, 59, 69*">WITH ventes_filtrees AS (
    SELECT 
        c.nom_commune,
        c.code_postal,
        d.code_departement,
        v.valeur
    FROM Vente v
    JOIN Bien b ON v.id_bien = b.id_bien
    JOIN Commune c ON b.id_coddep_codecommune = c.id_coddep_codecommune
    JOIN Departement d ON c.code_departement = d.code_departement
    WHERE d.code_departement IN ('06', '13', '33', '59', '69')
      AND v.valeur IS NOT NULL
),

-- Compter les ventes par commune dans les 5 départements
ventes_par_commune AS (
    SELECT 
        code_departement,
        nom_commune,
        COUNT(*) AS nb_ventes,
        ROUND(AVG(valeur), 2) AS moyenne_valeur_fonciere
    FROM ventes_filtrees
    GROUP BY code_departement, nom_commune
),

-- Classer les communes de chaque département par nombre de ventes
classement AS (
    SELECT 
        vpc.*,
        RANK() OVER (
            PARTITION BY code_departement
            ORDER BY nb_ventes DESC
        ) AS rang_commune
    FROM ventes_par_commune vpc
)

-- Garder uniquement le top 3 par département
SELECT 
    code_departement,
    nom_commune,
    nb_ventes,
    moyenne_valeur_fonciere
FROM classement
WHERE rang_commune &lt;= 3
ORDER BY code_departement, rang_commune;
</sql><sql name="Les 20 communes ayant le plus de transactions par tranche de 1000 habitants, parmi celles ayant plus de 10 000 habitants*">WITH ventes_par_commune AS (
    SELECT 
        c.id_coddep_codecommune,
        c.nom_commune,
        c.population,
        COUNT(*) AS nb_ventes
    FROM Vente v
    JOIN Bien b ON v.id_bien = b.id_bien
    JOIN Commune c ON b.id_coddep_codecommune = c.id_coddep_codecommune
    WHERE c.population &gt; 10000
    GROUP BY c.id_coddep_codecommune
),

ventes_par_1000hab AS (
    SELECT
        nom_commune,
        nb_ventes,
        population,
        ROUND(1000.0 * nb_ventes / population, 2) AS ventes_pour_1000_hab
    FROM ventes_par_commune
)

SELECT *
FROM ventes_par_1000hab
ORDER BY ventes_pour_1000_hab DESC
LIMIT 20;
</sql><current_tab id="8"/></tab_sql></sqlb_project>
